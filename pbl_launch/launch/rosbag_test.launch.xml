<launch>
    <node_container pkg="rclcpp_components" exec="component_container" name="pbl_container" namespace="/">
        <composable_node pkg="pbl_localization" plugin="pbl_localization::pbl_localization" name="pbl_localization">
            <param name="publish_tf" value="false"/>
        </composable_node>
        <composable_node pkg="robot_state_publisher" plugin="robot_state_publisher::RobotStatePublisher" name="robot_state_publisher" namespace="/">
            <param name="robot_description" value="$(command 'xacro $(find-pkg-share pbl_launch)/urdf/pbl.urdf.xacro')"/>
            <remap from="/joint_states" to="/joint_states"/>
            <param name="frame_prefix" value=""/>
            <param name="publish_frequency" value="100.0"/>
        </composable_node>
    </node_container>

    <node pkg="cartographer_ros" exec="cartographer_node" name="cartographer_node" output="screen"
        args="-configuration_directory $(find-pkg-share pbl_launch)/param -configuration_basename cartographer.lua load_state_filename $(find-pkg-share pbl_launch)/map/map.pbstream">
        <remap from="points2" to="/unilidar/cloud"/>
        <remap from="imu" to="/unilidar/imu"/>
        <remap from="odom" to="/odometry"/>
        <param name="use_sim_time" value="true"/>
    </node>

    <node pkg="cartographer_ros" exec="cartographer_occupancy_grid_node" name="cartographer_occupancy_grid_node" output="screen"
        args="-resolution 0.05 -publish_period_sec 1.0">
        <param name="use_sim_time" value="true"/>
    </node>


    <node pkg="rviz2" exec="rviz2" name="rviz2" output="screen"
        args="-d $(find-pkg-share pbl_launch)/rviz/pbl.rviz"/>
</launch>
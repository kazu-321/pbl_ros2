<launch>
    <arg name="map_pcd" default="$(find-pkg-share pbl_launch)/map/map.pcd"/>
    <arg name="nav2_params_file" default="$(find-pkg-share pbl_launch)/param/nav2.yaml"/>

    <node pkg="tf2_ros" exec="static_transform_publisher" name="map_to_odom" output="screen"
        args="0 0 0 0 0 0 map odom"/>

    <executable cmd="python3 $(find-pkg-share pbl_launch)/launch/publish_pcd.py $(var map_pcd) /map_3d map"/>

    <node pkg="pbl_sensing" exec="pbl_occupancy_grid_publisher_node" name="pbl_occupancy_grid_publisher" output="screen">
        <param name="map_topic" value="/map_3d"/>
        <param name="cloud_topic" value="/unilidar/cloud_filtered"/>
        <param name="map_frame_id" value="map"/>
        <param name="z_min" value="0.0"/>
        <param name="z_max" value="0.5"/>
        <param name="grid_resolution" value="0.05"/>
        <param name="occupied_count_full_score" value="10"/>
        <param name="transform_timeout_sec" value="0.1"/>
        <remap from="occupancy_grid" to="/map"/>
    </node>

    <node pkg="robot_state_publisher" exec="robot_state_publisher" name="robot_state_publisher" output="screen">
        <param name="robot_description" value="$(command 'xacro $(find-pkg-share pbl_launch)/urdf/pbl.urdf.xacro')"/>
        <param name="frame_prefix" value=""/>
        <param name="publish_frequency" value="100.0"/>
        <remap from="/joint_states" to="/joint_states"/>
    </node>

    <node pkg="pbl_localization" exec="pbl_wheel_odometry_node" name="pbl_wheel_odometry" output="screen">
        <param name="publish_tf" value="true"/>
        <param name="odom_frame_id" value="odom"/>
        <param name="base_frame_id" value="base_link"/>
        <param name="wheel_radius" value="0.05"/>
        <param name="wheel_separation" value="0.46"/>
    </node>

    <node pkg="pbl_simulation" exec="pbl_joint_state_simulator_node" name="pbl_joint_state_simulator" output="screen">
        <param name="wheel_radius" value="0.05"/>
        <param name="wheel_separation" value="0.46"/>
        <param name="max_wheel_speed_rad_s" value="30.0"/>
        <param name="wheel_acceleration_rad_s2" value="100.0"/>
        <param name="publish_rate_hz" value="100.0"/>
        <param name="command_timeout_sec" value="0.5"/>
    </node>

    <node pkg="joy" exec="game_controller_node" name="joy" output="screen" namespace="/controller">
        <param name="deadzone" value="0.1"/>
        <param name="autorepeat_rate" value="1000.0"/>
    </node>

    <node pkg="pbl_control" exec="pbl_control_node" name="pbl_control" output="screen">
        <param name="chassis_acceleration_rate_s" value="0.5"/>
    </node>

    <include file="$(find-pkg-share pbl_launch)/launch/nav2.launch.py">
        <arg name="use_sim_time" value="false"/>
        <arg name="autostart" value="true"/>
        <arg name="params_file" value="$(var nav2_params_file)"/>
    </include>

    <node pkg="rviz2" exec="rviz2" name="rviz2" output="screen" args="-d $(find-pkg-share pbl_launch)/rviz/pbl.rviz"/>
</launch>

<?xml version="1.0"?>
<robot name="pbl" xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:property name="body_length" value="0.45"/>
  <xacro:property name="body_width" value="0.45"/>
  <xacro:property name="body_height" value="0.015"/>
  <xacro:property name="pc_height" value="0.5"/>
  <xacro:property name="pc_width" value="0.1"/>
  <xacro:property name="wheel_radius" value="0.05"/>
  <xacro:property name="wheel_width" value="0.01"/>
  <xacro:property name="wheel_separation" value="0.46"/>
  <xacro:property name="base_center_offset" value="${body_length / 2.0 - 0.085}"/>
  <xacro:property name="rear_wheel_y" value="${wheel_separation / 2.0}"/>
  <xacro:property name="rear_wheel_z" value="${wheel_radius}"/>

  <material name="body_gray">
    <color rgba="0.85 0.85 0.85 1.0"/>
  </material>
  <material name="pc_black">
    <color rgba="0.08 0.08 0.08 1.0"/>
  </material>
  <material name="wheel_black">
    <color rgba="0.08 0.08 0.08 1.0"/>
  </material>

  <link name="base_link">
    <inertial>
      <origin xyz="0 0 ${wheel_radius + body_height / 2.0}" rpy="0 0 0"/>
      <mass value="12.0"/>
      <inertia ixx="0.20" ixy="0.0" ixz="0.0" iyy="0.20" iyz="0.0" izz="0.30"/>
    </inertial>
    <visual>
      <origin xyz="${base_center_offset} 0 ${wheel_radius + body_height / 2.0}" rpy="0 0 0"/>
      <geometry>
        <box size="${body_length} ${body_width} ${body_height}"/>
      </geometry>
      <material name="body_gray"/>
    </visual>
    <collision>
      <origin xyz="${base_center_offset} 0 ${wheel_radius + body_height / 2.0}" rpy="0 0 0"/>
      <geometry>
        <box size="${body_length} ${body_width} ${body_height}"/>
      </geometry>
    </collision>
  </link>

  <link name="pc">
    <visual>
      <origin xyz="0 0 ${pc_height / 2.0}" rpy="0 0 0"/>
      <geometry>
        <box size="${pc_width} ${body_width} ${pc_height}"/>
      </geometry>
      <material name="pc_black"/>
    </visual>
  </link>
  <joint name="base_link_to_pc" type="fixed">
    <parent link="base_link"/>
    <child link="pc"/>
    <origin xyz="-0.04 0 ${wheel_radius + body_height}" rpy="0 0 0"/>
  </joint>

  <link name="unilidar_lidar"/>
  <joint name="base_link_to_unilidar_lidar" type="fixed">
    <parent link="base_link"/>
    <child link="unilidar_lidar"/>
    <origin xyz="${body_length / 2.0 + base_center_offset} 0 ${wheel_radius + body_height / 2.0}" rpy="0 0 0.3"/>
  </joint>

  <link name="unilidar_imu"/>
  <joint name="unilidar_lidar_to_unilidar_imu" type="fixed">
    <parent link="unilidar_lidar"/>
    <child link="unilidar_imu"/>
    <origin xyz="-0.007698 -0.014655 0.00667" rpy="0 0 0"/>
  </joint>

  <xacro:macro name="drive_wheel" params="name x y">
    <link name="${name}_link">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.8"/>
        <inertia ixx="0.0008" ixy="0.0" ixz="0.0" iyy="0.0008" iyz="0.0" izz="0.0010"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="wheel_black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
    </link>

    <joint name="${name}" type="continuous">
      <parent link="base_link"/>
      <child link="${name}_link"/>
      <origin xyz="${x} ${y} ${rear_wheel_z}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:drive_wheel name="joint0" x="0.0" y="${-rear_wheel_y}"/>
  <xacro:drive_wheel name="joint1" x="0.0" y="${rear_wheel_y}"/>

</robot>